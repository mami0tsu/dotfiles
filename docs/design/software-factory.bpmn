<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SoftwareFactory" targetNamespace="urn:software-factory:bpmn">
  <bpmn:process id="SoftwareFactory" name="アイデアの登録からタスクの完了まで" isExecutable="false">
    <bpmn:laneSet id="FactoryLanes">
      <bpmn:lane id="HumanLane" name="人間">
        <bpmn:flowNodeRef>HumanStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Adopt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HumanReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConsiderIdea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConsiderGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IdeaDeferred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HumanReviewDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ApproveArtifact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="MainAILane" name="メイン AI">
        <bpmn:flowNodeRef>ResearchStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ResearchTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RegisterTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TicketTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WorkTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ArtifactReviewTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubmitTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareReviewTrigger</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="SubAILane" name="サブ AI">
        <bpmn:flowNodeRef>Research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewIdea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tickets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AIReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReleaseReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InvestigateIdea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="HumanStart">
      <bpmn:outgoing>Flow_HumanStart_Manual</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="ResearchStart" name="定期調査">
      <bpmn:outgoing>Flow_ResearchStart_ResearchTrigger</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ScheduledResearch" />
    </bpmn:startEvent>
    <bpmn:userTask id="Manual" name="アイデアを&#10;登録する">
      <bpmn:incoming>Flow_HumanStart_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Manual_Join</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Manual">
        <bpmn:dataOutput id="Data_Manual_0" />
        <bpmn:inputSet />
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_Manual_0</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Association_Manual_0">
        <bpmn:sourceRef>Data_Manual_0</bpmn:sourceRef>
        <bpmn:targetRef>IdeaRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="ResearchTrigger" name="調査スキルを&#10;起動する">
      <bpmn:incoming>Flow_ResearchStart_ResearchTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_ResearchTrigger_Research</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Research" name="リポジトリを&#10;調査する">
      <bpmn:incoming>Flow_ResearchTrigger_Research</bpmn:incoming>
      <bpmn:outgoing>Flow_Research_ReviewTrigger</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ReviewTrigger" name="レビュースキルを&#10;起動する">
      <bpmn:incoming>Flow_Research_ReviewTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewTrigger_ReviewIdea</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ReviewIdea" name="アイデアを&#10;レビューする">
      <bpmn:incoming>Flow_ReviewTrigger_ReviewIdea</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewIdea_ReviewGate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ReviewGate" gatewayDirection="Diverging" default="Flow_Reject">
      <bpmn:incoming>Flow_ReviewIdea_ReviewGate</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewGate_RegisterTrigger</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="RegisterTrigger" name="登録スキルを&#10;起動する">
      <bpmn:incoming>Flow_ReviewGate_RegisterTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_RegisterTrigger_Register</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Register" name="アイデアを&#10;登録する">
      <bpmn:incoming>Flow_RegisterTrigger_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_Join</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Register">
        <bpmn:dataOutput id="Data_Register_0" />
        <bpmn:inputSet />
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_Register_0</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Association_Register_0">
        <bpmn:sourceRef>Data_Register_0</bpmn:sourceRef>
        <bpmn:targetRef>IdeaRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Join" gatewayDirection="Converging">
      <bpmn:incoming>Flow_Manual_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Register_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_PrepareTrigger</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="PrepareTrigger" name="調査スキルを&#10;起動する">
      <bpmn:incoming>Flow_Join_PrepareTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareTrigger_Investigate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="InvestigateIdea" name="登録済みの&#10;アイデアを調査する">
      <bpmn:incoming>Flow_PrepareTrigger_Investigate</bpmn:incoming>
      <bpmn:outgoing>Flow_Investigate_PrepareReviewTrigger</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_InvestigateIdea">
        <bpmn:dataInput id="Data_InvestigateIdea_0" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Data_InvestigateIdea_0</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Association_InvestigateIdea_0">
        <bpmn:sourceRef>IdeaRef</bpmn:sourceRef>
        <bpmn:targetRef>Data_InvestigateIdea_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="PrepareReviewTrigger" name="レビュースキルを&#10;起動する">
      <bpmn:incoming>Flow_Investigate_PrepareReviewTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_Trigger_PrepareReview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PrepareReview" name="調査結果を&#10;レビューする">
      <bpmn:incoming>Flow_Trigger_PrepareReview</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareReview_Consider</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_PrepareReview">
        <bpmn:dataOutput id="Data_PrepareReview_0" />
        <bpmn:inputSet />
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_PrepareReview_0</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Association_PrepareReview_0">
        <bpmn:sourceRef>Data_PrepareReview_0</bpmn:sourceRef>
        <bpmn:targetRef>IdeaRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="ConsiderIdea" name="アイデアを&#10;レビューする">
      <bpmn:incoming>Flow_PrepareReview_Consider</bpmn:incoming>
      <bpmn:outgoing>Flow_Consider_Gate</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_ConsiderIdea">
        <bpmn:dataInput id="Data_ConsiderIdea_0" />
        <bpmn:dataOutput id="Data_ConsiderIdea_1" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Data_ConsiderIdea_0</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_ConsiderIdea_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Association_ConsiderIdea_0">
        <bpmn:sourceRef>IdeaRef</bpmn:sourceRef>
        <bpmn:targetRef>Data_ConsiderIdea_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_ConsiderIdea_1">
        <bpmn:sourceRef>Data_ConsiderIdea_1</bpmn:sourceRef>
        <bpmn:targetRef>IdeaRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ConsiderGate" gatewayDirection="Diverging" default="Flow_Defer">
      <bpmn:incoming>Flow_Consider_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Proceed_Adopt</bpmn:outgoing>
      <bpmn:outgoing>Flow_Defer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="IdeaDeferred" name="見送り">
      <bpmn:incoming>Flow_Defer</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Adopt" name="アイデアを&#10;採用する">
      <bpmn:incoming>Flow_Proceed_Adopt</bpmn:incoming>
      <bpmn:outgoing>Flow_Adopt_TicketTrigger</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Adopt">
        <bpmn:dataOutput id="Data_Adopt_0" />
        <bpmn:inputSet />
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_Adopt_0</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Association_Adopt_0">
        <bpmn:sourceRef>Data_Adopt_0</bpmn:sourceRef>
        <bpmn:targetRef>IdeaRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:task id="TicketTrigger" name="起票スキルを&#10;起動する">
      <bpmn:incoming>Flow_Adopt_TicketTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_TicketTrigger_Tickets</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Tickets" name="合意した内容で&#10;タスクを起票する">
      <bpmn:incoming>Flow_TicketTrigger_Tickets</bpmn:incoming>
      <bpmn:outgoing>Flow_Tickets_Ready</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Tickets">
        <bpmn:dataInput id="Data_Tickets_0" />
        <bpmn:dataOutput id="Data_Tickets_1" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Data_Tickets_0</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_Tickets_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Association_Tickets_0">
        <bpmn:sourceRef>IdeaRef</bpmn:sourceRef>
        <bpmn:targetRef>Data_Tickets_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_Tickets_1">
        <bpmn:sourceRef>Data_Tickets_1</bpmn:sourceRef>
        <bpmn:targetRef>TicketRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Ready" name="着手可能になった">
      <bpmn:incoming>Flow_Tickets_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_WorkTrigger</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="WhenReady">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">タスクが着手条件を満たしている</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="WorkTrigger" name="作業スキルを&#10;起動する">
      <bpmn:incoming>Flow_Ready_WorkTrigger</bpmn:incoming>
      <bpmn:incoming>Flow_Revision_WorkTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_WorkTrigger_Work</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Work" name="成果物を作る">
      <bpmn:incoming>Flow_WorkTrigger_Work</bpmn:incoming>
      <bpmn:outgoing>Flow_Work_ArtifactReviewTrigger</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Work">
        <bpmn:dataInput id="Data_Work_0" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Data_Work_0</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Association_Work_0">
        <bpmn:sourceRef>TicketRef</bpmn:sourceRef>
        <bpmn:targetRef>Data_Work_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="ArtifactReviewTrigger" name="レビュースキルを&#10;起動する">
      <bpmn:incoming>Flow_Work_ArtifactReviewTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_ArtifactReviewTrigger_AIReview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AIReview" name="成果物を&#10;レビューする">
      <bpmn:incoming>Flow_ArtifactReviewTrigger_AIReview</bpmn:incoming>
      <bpmn:outgoing>Flow_AIReview_HumanReview</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_AIReview">
        <bpmn:dataOutput id="Data_AIReview_0" />
        <bpmn:inputSet />
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_AIReview_0</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Association_AIReview_0">
        <bpmn:sourceRef>Data_AIReview_0</bpmn:sourceRef>
        <bpmn:targetRef>ReviewRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="HumanReview" name="成果物を&#10;レビューする">
      <bpmn:incoming>Flow_AIReview_HumanReview</bpmn:incoming>
      <bpmn:outgoing>Flow_HumanReview_Gateway</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_HumanReview">
        <bpmn:dataInput id="Data_HumanReview_0" />
        <bpmn:dataOutput id="Data_HumanReview_1" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Data_HumanReview_0</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_HumanReview_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Association_HumanReview_0">
        <bpmn:sourceRef>ReviewRef</bpmn:sourceRef>
        <bpmn:targetRef>Data_HumanReview_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_HumanReview_1">
        <bpmn:sourceRef>Data_HumanReview_1</bpmn:sourceRef>
        <bpmn:targetRef>ReviewRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="HumanReviewDecision" gatewayDirection="Diverging" default="Flow_Revision_WorkTrigger">
      <bpmn:incoming>Flow_HumanReview_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NoIssues_Approval</bpmn:outgoing>
      <bpmn:outgoing>Flow_Revision_WorkTrigger</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ApproveArtifact" name="成果物を&#10;承認する">
      <bpmn:incoming>Flow_NoIssues_Approval</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_SubmitTrigger</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="SubmitTrigger" name="リリーススキルを&#10;起動する">
      <bpmn:incoming>Flow_Approval_SubmitTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_Trigger_ReleaseReady</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ReleaseReady" name="リリース可能になった">
      <bpmn:incoming>Flow_Trigger_ReleaseReady</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseReady_Submit</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="WhenReleaseReady">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">タスクがリリース可能な状態にある</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Submit" name="承認済みの&#10;成果物をリリースする">
      <bpmn:incoming>Flow_ReleaseReady_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_End</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_Submit">
        <bpmn:dataInput id="Data_Submit_0" />
        <bpmn:dataOutput id="Data_Submit_1" />
        <bpmn:inputSet>
          <bpmn:dataInputRefs>Data_Submit_0</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet>
          <bpmn:dataOutputRefs>Data_Submit_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="Association_Submit_0">
        <bpmn:sourceRef>ReviewRef</bpmn:sourceRef>
        <bpmn:targetRef>Data_Submit_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_Submit_1">
        <bpmn:sourceRef>Data_Submit_1</bpmn:sourceRef>
        <bpmn:targetRef>ArtifactRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="End" name="処理終了">
      <bpmn:incoming>Flow_Submit_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Rejected" name="登録しない">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_HumanStart_Manual" sourceRef="HumanStart" targetRef="Manual" />
    <bpmn:sequenceFlow id="Flow_ResearchStart_ResearchTrigger" sourceRef="ResearchStart" targetRef="ResearchTrigger" />
    <bpmn:sequenceFlow id="Flow_ResearchTrigger_Research" sourceRef="ResearchTrigger" targetRef="Research" />
    <bpmn:sequenceFlow id="Flow_Research_ReviewTrigger" sourceRef="Research" targetRef="ReviewTrigger" />
    <bpmn:sequenceFlow id="Flow_ReviewTrigger_ReviewIdea" sourceRef="ReviewTrigger" targetRef="ReviewIdea" />
    <bpmn:sequenceFlow id="Flow_ReviewIdea_ReviewGate" sourceRef="ReviewIdea" targetRef="ReviewGate" />
    <bpmn:sequenceFlow id="Flow_ReviewGate_RegisterTrigger" sourceRef="ReviewGate" targetRef="RegisterTrigger" />
    <bpmn:sequenceFlow id="Flow_RegisterTrigger_Register" sourceRef="RegisterTrigger" targetRef="Register" />
    <bpmn:sequenceFlow id="Flow_Manual_Join" sourceRef="Manual" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Register_Join" sourceRef="Register" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Consider_Gate" sourceRef="ConsiderIdea" targetRef="ConsiderGate" />
    <bpmn:sequenceFlow id="Flow_Proceed_Adopt" sourceRef="ConsiderGate" targetRef="Adopt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">人間がアイデアを採用する</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Defer" sourceRef="ConsiderGate" targetRef="IdeaDeferred" />
    <bpmn:sequenceFlow id="Flow_Adopt_TicketTrigger" sourceRef="Adopt" targetRef="TicketTrigger" />
    <bpmn:sequenceFlow id="Flow_TicketTrigger_Tickets" sourceRef="TicketTrigger" targetRef="Tickets" />
    <bpmn:sequenceFlow id="Flow_Tickets_Ready" sourceRef="Tickets" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_Ready_WorkTrigger" sourceRef="Ready" targetRef="WorkTrigger" />
    <bpmn:sequenceFlow id="Flow_WorkTrigger_Work" sourceRef="WorkTrigger" targetRef="Work" />
    <bpmn:sequenceFlow id="Flow_Work_ArtifactReviewTrigger" sourceRef="Work" targetRef="ArtifactReviewTrigger" />
    <bpmn:sequenceFlow id="Flow_ArtifactReviewTrigger_AIReview" sourceRef="ArtifactReviewTrigger" targetRef="AIReview" />
    <bpmn:sequenceFlow id="Flow_AIReview_HumanReview" sourceRef="AIReview" targetRef="HumanReview" />
    <bpmn:sequenceFlow id="Flow_HumanReview_Gateway" sourceRef="HumanReview" targetRef="HumanReviewDecision" />
    <bpmn:sequenceFlow id="Flow_NoIssues_Approval" sourceRef="HumanReviewDecision" targetRef="ApproveArtifact" name="問題なし">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">問題がない</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Revision_WorkTrigger" sourceRef="HumanReviewDecision" targetRef="WorkTrigger" name="修正" />
    <bpmn:sequenceFlow id="Flow_Approval_SubmitTrigger" sourceRef="ApproveArtifact" targetRef="SubmitTrigger" />
    <bpmn:sequenceFlow id="Flow_Trigger_ReleaseReady" sourceRef="SubmitTrigger" targetRef="ReleaseReady" />
    <bpmn:sequenceFlow id="Flow_ReleaseReady_Submit" sourceRef="ReleaseReady" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_Submit_End" sourceRef="Submit" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="ReviewGate" targetRef="Rejected" name="見送り" />
