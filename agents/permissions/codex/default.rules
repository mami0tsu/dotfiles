prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "worktree", "add"], decision="allow")
prefix_rule(pattern=["git", "wt"], decision="allow")
prefix_rule(pattern=["git", "remote", "show"], decision="allow")
prefix_rule(pattern=["git", "ls-remote"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["npm", "view"], decision="allow")
prefix_rule(pattern=["ax"], decision="allow")
prefix_rule(pattern=["difit"], decision="allow")
prefix_rule(pattern=["nix", "fmt"], decision="allow")
prefix_rule(pattern=["nix", "eval"], decision="allow")
prefix_rule(pattern=["nix", "build", "--no-link", "--no-write-lock-file"], decision="allow")
prefix_rule(pattern=["nix", "build", "--no-write-lock-file", "--no-link"], decision="allow")
prefix_rule(pattern=["nix", "build", "--dry-run", "--no-write-lock-file"], decision="allow")
prefix_rule(pattern=["nix", "build", "--no-write-lock-file", "--dry-run"], decision="allow")
